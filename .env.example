# Optional External Recipe & Nutrition API Credentials (Server-Side Only)
# Never expose these keys with NEXT_PUBLIC_ prefixes.

# USDA FoodData Central API (Public Domain CC0 1.0)
# Register free at https://fdc.nal.usda.gov/api-key-signup.html (1,000 req/hr)
USDA_FDC_API_KEY=

# Edamam Recipe Search API v2 (Free Developer Plan: 10,000 calls/mo)
EDAMAM_APP_ID=
EDAMAM_APP_KEY=

# FatSecret Platform API (Free Basic Edition: 5,000 calls/day, OAuth 2.0)
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# TheMealDB Public API (defaults to free test key "1"; set THEMEALDB_ENABLED=false to disable)
THEMEALDB_API_KEY=1
THEMEALDB_ENABLED=true

# Spoonacular Food API (optional; strict 1-hour cache limit)
SPOONACULAR_API_KEY=

# Optional PostgreSQL / Supabase connection string for cloud deployment
DATABASE_URL=

# Optional zero-cost cloud persistence for shared Favorites across Render redeploys
# (Upstash Redis REST free tier OR a GitHub Gist + PAT)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GITHUB_TOKEN=
FAVORITES_GIST_ID=
